# ユーザーID
UID=1000
# グループID
GID=1000
# ユーザー名
USERNAME=appuser
# グループ名
GROUPNAME=appuser
# pyenvでインストールするpythonのバージョン
PYTHON_VERSION=3.14.0
# 追加インストールするNodeJSのバージョン
NODE_VERSION=24
# docker-composeのアーキテクチャ（macOSのRosetta2のEOSを見据えて）
ARCH=x86_64
# AIエージェントの有効化(とりあえずfalse)
ENABLE_CURSOR=false
ENABLE_GEMINI=false
ENABLE_CODEX=false
ENABLE_CLAUDE=false